{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AzureSql": "Server=tcp:<your-server>.database.windows.net,1433;Database=CampusRelay;User ID=<user>;Password=<password>;Encrypt=True;TrustServerCertificate=False;",
    "RenderPostgres": ""
  },
  "Jwt": {
    "Issuer": "campusrelay-api",
    "Audience": "campusrelay-app",
    "Key": "REPLACE_WITH_A_LONG_RANDOM_SECRET_BEFORE_ANY_REAL_DEPLOYMENT"
  },
  "Firebase": {
    "ProjectId": "REPLACE_WITH_YOUR_FIREBASE_PROJECT_ID",
    "ServiceAccountFilePath": "firebase-service-account.json"
  }
}
